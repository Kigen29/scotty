{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/inbound/website.ts": {
      "maxDuration": 120
    },
    "api/fn/[name].ts": {
      "maxDuration": 120
    },
    "api/inbound/email.ts": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|@|src/|node_modules/)[^.]*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/digest",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/digest?period=week",
      "schedule": "0 5 * * 1"
    }
  ]
}
