# Server-side settings for the api/ functions. Set them in Vercel → scotty → Settings → Environment Variables.
# For local work: `vercel env pull .env.local`, then `vercel dev`.

# Neon Postgres (the same database as code5developers.com; Scotty's tables are in the `scotty` schema)
DATABASE_URL=

# The single operator: their uuid owns every row, and they sign in with this email
OPERATOR_USER_ID=
OPERATOR_EMAIL=
SCOTTY_PASSWORD=
# At least 32 random characters; signs the session cookie (openssl rand -hex 32)
SCOTTY_SECRET=

# Where this app lives, for links in alert emails
APP_URL=https://scotty.code5developers.com

# Website enquiries: code5developers.com posts them to /api/inbound/website with this secret (same value on both projects)
INBOUND_SECRET=

# Claude sorts each incoming message and drafts a reply: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Email through Resend: alerts to the studio, and replies to people who wrote first (never cold outreach)
RESEND_API_KEY=
MAIL_FROM="Scotty <scotty@code5developers.com>"
REPLY_FROM="Code 5 Developers <info@code5developers.com>"
# Optional: comma-separated inboxes for alerts, and where replies to our replies go. Both default to info@code5developers.com
STUDIO_INBOX=
REPLY_TO=

# Email replies come back to Scotty: replies go to reply+<lead>@INBOUND_DOMAIN, which Resend receives and posts
# to /api/inbound/email. Set after adding the domain under Resend -> Receiving and creating the webhook.
INBOUND_DOMAIN=in.code5developers.com
RESEND_WEBHOOK_SECRET=

# Discovery: Google Places API (New) Text Search. Create the key in Google Cloud, restricted to Places API (New).
GOOGLE_PLACES_API_KEY=
# Google searches allowed per calendar month. Each discovery run uses up to 3. Google gives 1,000 free a month.
PLACES_MONTHLY_LIMIT=900

# Vercel sends this with each cron call (daily digest at 08:00 Nairobi, weekly report on Mondays). Any long random string.
CRON_SECRET=
